# ============================================================================
# NooblyJS Wiki Sync Daemon — OPERATIONAL settings.
#
# This file does NOT configure what gets synced. The server URL, the API token
# and the folder selection are set from the dashboard's setup screen and stored
# in .daemon-config.json. Start the daemon, open http://localhost:11100, and
# fill it in there.
#
# The one exception is a FIRST run: if .daemon-config.json does not exist yet,
# WIKI_URL, WIKI_API_TOKEN and WATCH_FOLDER below are used to PRE-FILL the setup
# form, so an install that already ran from .env is not stranded behind a blank
# screen. Once a value has been saved from the UI these are never read again.
# ============================================================================

# --- first-run pre-fill only (optional) -------------------------------------
# WIKI_URL=https://wiki.example.com
# WIKI_API_TOKEN=dtk_your_personal_access_token

# Local root. Each selected folder is mirrored to
#   <local folder>/<Space Name>/<remote/folder/path>
#
# This is now CHOSEN IN THE UI (setup screen, and Configure -> Change local
# folder) and stored in .daemon-config.json. Setting WATCH_FOLDER only changes
# the value the form is pre-filled with, which is what a scripted deployment
# wants; leave it unset and the default is a "NooblyJS Wiki" folder in
# the user's Documents. Changing it here after the fact moves nothing.
# WATCH_FOLDER=./watch

# --- how to run -------------------------------------------------------------

# How often to poll the wiki change feed, in milliseconds.
SYNC_INTERVAL=5000

# Folder/file names to skip. Matched against whole path segments, not globs.
IGNORE_PATTERNS=.git,node_modules,.DS_Store,Thumbs.db,.idea,.vscode

# Accept a self-signed / untrusted TLS certificate from the server.
# DEV ONLY — verification is disabled for the daemon's API client only, not
# process-wide.
# WIKI_TLS_INSECURE=false
#
# Against a LOCAL backend over HTTPS, prefer trusting the dev certificate
# instead of disabling verification. NOTE: this must be a REAL environment
# variable — OpenSSL reads it as Node starts, before dotenv runs, so setting it
# in this file does nothing:
#
#   PowerShell:  $env:NODE_EXTRA_CA_CERTS = "<repo>\backend\certs\server.crt"
#
# `--use-system-ca` (passed by npm start) only helps when the certificate was
# issued by a CA in the Windows store. The repo's dev certificate is its own
# issuer, so it needs NODE_EXTRA_CA_CERTS or WIKI_TLS_INSECURE.

# --- status dashboard -------------------------------------------------------

DASHBOARD_PORT=11100

# The dashboard carries the API token form and can delete local folders, so it
# binds to localhost only. Widen it deliberately (e.g. 0.0.0.0) and turn on auth
# below if you do.
DASHBOARD_HOST=127.0.0.1

# Require Basic credentials or a Bearer dtk_ token to view the dashboard.
# DASHBOARD_REQUIRE_AUTH=true
# DASHBOARD_USER=admin@example.com
# DASHBOARD_PASSWORD=change-me
