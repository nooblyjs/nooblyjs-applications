{
  "manifest_version": 3,
  "name": "NooblyJS Wiki",
  "version": "1.0.0",
  "description": "Read-only access to your NooblyJS Wiki documentation",
  "permissions": [
    "storage",
    "identity",
    "identity.email",
    "sidePanel"
  ],
  "host_permissions": [
    "https://localhost:9101/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "config.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Open Wiki side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
