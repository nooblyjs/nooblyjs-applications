# ============================================================================
# APPLICATION DATA DIRECTORY
# ============================================================================
# The base directory where the application stores its data (spaces, logs, etc.). Relative paths are resolved against this directory. The default is ../.application (relative to the backend root).
# The secrets that we use to secure the session and settings
APP_BASE_DIR=

# ============================================================================
# Our secrets that we use to secure the session and settings.
# These should be long, random strings.
# In production, you should generate new secrets and keep them private.
# ============================================================================
SESSION_SECRET=
SETTINGS_SECRET=

# ============================================================================
# NooblyJS Wiki Platform - Development Configuration
# For production, copy .env.example and update values
# ============================================================================
# DEVELOPMENT OVERRIDES
# ============================================================================
NODE_TLS_REJECT_UNAUTHORIZED=0
NODE_ENV=

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=

# ============================================================================
# HTTPS / TLS CONFIGURATION
# ============================================================================
# Entra (Azure AD) SSO uses a cross-site form_post callback whose session cookie
# must be SameSite=None; Secure — i.e. it requires HTTPS. Generate dev certs with
# `npm run certs` (run in ./backend; writes ./backend/certs/).
HTTPS_ENABLED=
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# ============================================================================
# MICROSOFT ENTRA (AZURE AD) SINGLE SIGN-ON
# ============================================================================
# When CLIENT_ID + TENANT_ID are set, end users are auto-redirected to Microsoft
# to sign in (no login form). BASE_URL is this app's public origin; the redirect
# URI registered in the Entra app must be BASE_URL + /services/authservice/openid
# (registered as a "Web" platform). Admins can still use local credentials at
# /services/authservice/views/login.html?local=1
AZURE_AD_CLIENT_ID=
AZURE_AD_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_BASE_URL=

# ============================================================================
# AUTHENTICATION METHOD  —  switch sign-in between local and Azure AD here
# ============================================================================
# AUTH_METHOD selects how users sign in to the whole platform:
#   local  → file-based username / password login form (Passport local). DEFAULT.
#   azure  → Microsoft Entra (Azure AD) SSO; users are auto-redirected to Microsoft.
#            Admins can still use local credentials at
#            /services/authservice/views/login.html?local=1
#
# To use Azure: set AUTH_METHOD=azure, fill in the AZURE_AD_* values below, AND set
# HTTPS_ENABLED=true above (the Entra form_post callback needs a SameSite=None;
# Secure cookie, which requires HTTPS — run `npm run certs` in ./backend first).
# If AUTH_METHOD=azure but the AZURE_AD_* values are missing, the app falls back to
# local sign-in and logs a warning.
AUTH_METHOD=

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Allow Chrome extension, Teams, and localhost development
CORS_ORIGINS=

# ============================================================================
# Solution Design Parameters
# ============================================================================
aris_server=
aris_username=
aris_password=

design_solution_datafolder=

# ============================================================================
# Business Process Parameters
# ============================================================================
design_process_contentfolder=
design_process_datafolder=

# ============================================================================
# Infrastructure Design Parameters
# ============================================================================
design_infrastructure_contentfolder=
design_infrastructure_datafolder=

# ============================================================================
# Product Design Parameters
# ============================================================================
product_design_server=
product_design_username=
product_design_password=

product_design_contentfolder=
product_design_datafolder=

# ============================================================================
# Application Design Parameters
# ============================================================================
# Bitbucket credentials for the application-design workflows. A Bitbucket API
# token authenticates as username:token, so BOTH are required — the clone URL is
# built as https://${BITBUCKET_USERNAME}:${BITBUCKET_API_TOKEN}@bitbucket.org/...
# Repository-listing documents carry the [user]:[token] PLACEHOLDERS, never these
# values; discover-repos.js substitutes them when it writes a schedule, and
# fetch-code.js expands them in memory at clone time. Nothing writes a secret to
# disk. NOTE: this is the repo-root .env — the file the app actually loads.
BITBUCKET_API_TOKEN=
BITBUCKET_USERNAME=

# Where "Source Repository Discovery" scans for repository-listing documents.
# Optional: the workflow's own `configurationlocation` input wins, and its
# defaultInput already sets one. Set this only to change the fallback.
application_design_contentfolder=

# The .application working folder each repository is cloned into (one subfolder
# per repo Name). Host/deployment state, so it stays env-driven.
application_design_datafolder=

# ============================================================================
# AI Agent Configuration
# ============================================================================
#ollama
OLLAMA_ENDPOINT=
OLLAMA_MODEL=

#claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

#gemini
GEMINI_API_KEY=
GEMINI_MODEL=

#openai-kv
AZURE_KEYVAULT_TENANT_ID=
AZURE_KEYVAULT_CLIENT_ID=
AZURE_KEYVAULT_CLIENT_SECRET=
AZURE_KEYVAULT_URL=

# ============================================================================
# Workflow service account (schedule API + wiki API used by workflow steps)
# ============================================================================
# Pre-shared static service token. On startup the backend registers this value
# as a long-lived (10-year) bearer token for a synthetic "workflow-service" user
# with admin + Datasources Administrator roles (backend/src/wiki/initialize.js).
# It is for callers OUTSIDE this process (scripts, curl, integrations) — no login,
# survives restarts. Treat it like an API key.
# Previous static service token (kept commented for easy revert):
# WORKFLOW_API_TOKEN=your_workflow_api_token
WORKFLOW_API_TOKEN=

# WORKFLOW_API_URL / WORKFLOW_API_USER / WORKFLOW_API_PASSWORD were removed on
# 2026-07-25. Workflow steps no longer call this backend over HTTP (the :443
# HTTPS + Entra front end broke every self-call): schedule operations go through
# the file-based workflow bridge under APP_BASE_DIR/workflow/.bridge, and the
# context build reads spaces straight off disk. Nothing reads those three
# variables any more — delete them from your .env.

# ============================================================================
# WIKI FEATURE FLAGS — not configured here
# ============================================================================
# The AI chat panel and document editing toggles live in the core settings store
# under the "wiki" group. Edit them in the datasources Settings screen; they take
# effect on the next page load, with no restart. Defined in
# backend/src/wiki/config/featureFlags.js and served to the frontends by
# /applications/wiki/api/config.

# ============================================================================
# FEATURE 5: EMAIL SSO (SINGLE SIGN-ON)
# ============================================================================
SSO_SECRET=
SSO_ALLOWED_RETURN_URLS=

# ============================================================================
# Services Configuration: This configuration determines which services are enabled and how they are configured.
# Each service can be enabled or disabled, and may have additional configuration options.
# Each switch below names the EXTERNAL provider explicitly; any other value
# (including empty) selects the embedded in-process one, so an unset .env still
# boots with no infrastructure running.
# CACHING_SERVICE: redis    | anything else = in-memory
# SEARCH_SERVICE:  solr     | anything else = in-memory
# QUEUE_SERVICE:   activemq | anything else = in-memory
# ============================================================================
CACHING_SERVICE=
SEARCH_SERVICE=
QUEUE_SERVICE=

# --- SOLR (only read when SEARCH_SERVICE=solr) ------------------------------
# Prefer a literal IP over a hostname: a named host costs a dns.lookup() on every
# request, which shares libuv's threadpool with all file I/O and times out under
# an index build. See the comment in app.js.
SOLR_URL=http://127.0.0.1:8983/solr
SOLR_COLLECTION=default
SOLR_COMMIT_WITHIN_MS=60000
SOLR_TIMEOUT_MS=30000
# Default `rows` for any search that does not size its own request. The provider
# ships with 50, which is a CHUNK-row count, not a document count — the wiki
# indexes long documents as ~6 chunks and folds them back together, so 50 rows
# is about 9 results.
SOLR_MAX_ROWS=1000

# --- ActiveMQ (only read when QUEUE_SERVICE=activemq) -----------------------
# 127.0.0.1 rather than localhost, for the same dns.lookup() reason as SOLR_URL.
ACTIVEMQ_HOST=127.0.0.1
ACTIVEMQ_STOMP_PORT=61613
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin
ACTIVEMQ_JOLOKIA_URL=http://127.0.0.1:8161/api/jolokia
# Client-side deadline for each Jolokia (JMX-over-HTTP) call — how queue depth
# is read. It is a whole-round-trip budget spent by anything that delays the
# request inside this process, so a busy host defeats a tight value: the
# provider's old hard-coded 10s timed out during search index builds against a
# broker answering in ~13ms.
ACTIVEMQ_JOLOKIA_TIMEOUT_MS=30000
# NOTE: there is deliberately no brokerName setting. It is the JMX identifier
# inside the MBean name and really is the literal string "localhost" — an IP
# there breaks every lookup.

# --- Wiki search sizing (provider-independent) ------------------------------
# Ceiling on the rows the wiki asks the engine for. It requests the caller's
# document budget scaled by the chunk fan-out, capped here — each row carries the
# document's excerpt and headings, so ~1,200 rows is ~8.7MB / ~1s against SOLR
# and ~3,000 is ~21MB / ~4.5s. Raise to trade latency for reach.
WIKI_SEARCH_PROVIDER_ROWS=1000


