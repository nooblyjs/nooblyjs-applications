{
  "name": "digital-technologies-knowledge-datasources",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "app.js",
  "scripts": {
    "install:all": "npm run install:backend && npm run install:web && npm run install:teams && npm run install:daemon && npm run install:vscode && npm run install:electron && npm run install:workflows",
    "install:workflows": "cd ../nooblyjs-app-wiki-workflows && npm install",
    "install:server": "npm run install:backend && npm run install:web && npm run install:teams",
    "install:backend": "cd backend && npm install",
    "install:web": "npm run install:web-datasources && npm run install:web-wiki",
    "install:web-datasources": "cd applications/web/datasources && npm install",
    "install:web-wiki": "cd applications/web/wiki && npm install",
    "install:teams": "npm run install:teams-datasources && npm run install:teams-wiki",
    "install:teams-datasources": "cd applications/teams/datasources && npm install",
    "install:teams-wiki": "cd applications/teams/wiki && npm install",
    "install:daemon": "cd applications/daemon/wiki && npm install",
    "install:vscode": "cd applications/vscode/wiki && npm install",
    "install:electron": "npm run install:electron-wiki && npm run install:electron-datasources",
    "install:electron-wiki": "cd applications/electron/wiki && npm install",
    "install:electron-datasources": "cd applications/electron/datasources && npm install",
    "install:sharepoint": "cd applications/sharepoint/wiki && npm install",
    "dev": "concurrently \"node  --max-old-space-size=8192 app.js\"  ",
    "dev:web": "node backend/node_modules/nodemon/bin/nodemon.js app.js",
    "dev:electron:wiki": "cd applications/electron/wiki && npm start",
    "dev:electron:datasources": "cd applications/electron/datasources && npm start",
    "dev:daemon": "cd applications/daemon && npm run dev",
    "start": "node app.js",
    "certs": "cd backend && npm run certs",
    "build:teams:dev": "node scripts/build-teams-package.js",
    "build:teams:prod": "node scripts/build-teams-package.js",
    "build:chrome:dev": "node applications/chrome/wiki/build.js",
    "build:chrome:prod": "node applications/chrome/wiki/build.js --https://wiki.example.com/",
    "tests": "cd backend && npm run tests",
    "test:watch": "cd backend && npm run test:watch",
    "test:coverage": "cd backend && npm run test:coverage",
    "kill": "node scripts/kill-port.js",
    "clean": "rimraf node_modules backend/node_modules applications/web/datasources/node_modules applications/web/wiki/node_modules applications/teams/datasources/node_modules applications/teams/wiki/node_modules applications/daemon/wiki/node_modules applications/vscode/wiki/node_modules applications/electron/wiki/node_modules applications/electron/datasources/node_modules"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "joi": "^18.2.9",
    "nooblyjs-core": "../nooblyjs-core/",
    "passport": "^0.7.0",
    "rimraf": "^6.1.3",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests/backend"
    ],
    "modulePaths": [
      "<rootDir>/backend/node_modules"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "<rootDir>/tests/backend/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/backend/setup.js"
    ],
    "collectCoverageFrom": [
      "backend/src/**/*.js",
      "!backend/src/views/**",
      "!backend/src/public/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 10000
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "concurrently": "^9.2.3",
    "jest": "^30.2.0"
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true
  }
}
